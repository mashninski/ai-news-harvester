# Кэш Python, появляется после локального запуска или тестов
__pycache__/
.pytest_cache/

# Файл состояния коллектора. Войдёт ли он в git постоянно (как twitch-state.json
# у бота-твіча) — решается на этапе 7 плана, до тех пор не коммитится
data/*.sqlite
data/*.sqlite-journal

# Зависимости Node-подпроекта конвертера: ставятся npm ci в tools/taraskevize
node_modules/

# Черновики карточек (этап 4). Куда они едут дальше — PR в сайт, этап 5
output/

# Прогон на эталонном корпусе: производное от приватного корпуса сайта и
# тексты чужих статей — в публичный репозиторий не кладём
data/eval/
